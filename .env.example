# Azure AI Foundry configuration
# Copy this file to .env and fill in your values

# ---------------------------------------------------------------------------
# VITE_FOUNDRY_ENDPOINT
#
# Two endpoint formats are supported — paste whichever you have:
#
# A) New Azure AI Foundry project (ai.azure.com → your project → Overview)
#    Format:  https://your-project-name.services.ai.azure.com
#
# B) Classic Azure OpenAI resource (portal.azure.com)
#    Format:  https://your-resource-name.openai.azure.com
# ---------------------------------------------------------------------------
VITE_FOUNDRY_ENDPOINT=https://your-project.services.ai.azure.com

# ---------------------------------------------------------------------------
# VITE_FOUNDRY_API_KEY
# Found in: your project → Settings → Keys and Endpoint (or Deployments page)
# ---------------------------------------------------------------------------
VITE_FOUNDRY_API_KEY=your-api-key-here

# ---------------------------------------------------------------------------
# VITE_FOUNDRY_DEPLOYMENT
# The name you gave the deployment when you created it.
# For new Foundry projects this is usually the model name, e.g. gpt-4o
# For classic Azure OpenAI it's whatever you named the deployment.
# ---------------------------------------------------------------------------
VITE_FOUNDRY_DEPLOYMENT=gpt-4o
